{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/dfosco/tiny-canvas/main/schemas/canvas-publication.v1.schema.json",
  "title": "Tiny Canvas portable publication inventory v1",
  "description": "Public, deterministic inventory of an independent, editable Tiny Canvas + React handoff project. Powers generated AGENTS.md, page routing, asset integrity checks, source ownership and safe republishing. This is not the Hypercanvas Notebook manifest or a private runtime registry. A widget catalog entry records BOTH the original producer sourceType and normalized portableType so Tiny Canvas can rebuild presentations offline after teammates edit source JSONL.",
  "type": "object",
  "required": [
    "schemaVersion",
    "publicationId",
    "producer",
    "pages",
    "artifacts",
    "widgetTypes"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "publicationId": {
      "type": "string",
      "minLength": 1
    },
    "producer": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "kind",
          "route"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "canvas-jsonl",
              "canvas-mdx",
              "prototype",
              "site"
            ]
          },
          "route": {
            "type": "string",
            "minLength": 1
          },
          "sourcePath": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[A-Za-z0-9._/@+ -]+$"
          },
          "presentationPath": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[A-Za-z0-9._/@+ -]+$"
          },
          "href": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "path",
          "ownership",
          "editable"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "canvas-document",
              "canvas-presentation",
              "mdx",
              "prototype",
              "component",
              "asset",
              "snapshot",
              "site-reference",
              "agent-guide",
              "configuration"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[A-Za-z0-9._/@+ -]+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "ownership": {
            "enum": [
              "handoff",
              "generated",
              "external"
            ]
          },
          "editable": {
            "type": "boolean"
          },
          "description": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "widgetTypes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "sourceType",
          "count",
          "presentationKinds",
          "portableType"
        ],
        "properties": {
          "sourceType": {
            "type": "string",
            "minLength": 1
          },
          "count": {
            "type": "integer",
            "minimum": 0
          },
          "presentationKinds": {
            "type": "array",
            "items": {
              "enum": [
                "note",
                "markdown",
                "image",
                "link",
                "frame",
                "file",
                "code",
                "component",
                "gallery",
                "controls",
                "prompt",
                "terminal",
                "agent",
                "redacted",
                "unavailable"
              ]
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "editableProps": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name",
                "type"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "type": {
                  "type": "string",
                  "minLength": 1
                },
                "description": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "portableType": {
            "enum": [
              "note",
              "markdown",
              "image",
              "link",
              "frame",
              "file",
              "code",
              "component",
              "gallery",
              "controls",
              "prompt",
              "terminal",
              "agent",
              "redacted",
              "unavailable"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "severity",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": [
              "info",
              "warning",
              "error"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "pageId": {
            "type": "string",
            "minLength": 1
          },
          "widgetId": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
